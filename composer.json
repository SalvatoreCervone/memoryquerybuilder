{
  "name": "salvatorecervone/memoryquerybuilder",
  "description": "An Eloquent-style in-memory query builder for PHP arrays and objects",
  "type": "library",
  "license": "MIT",
  "keywords": [
    "query-builder",
    "eloquent",
    "array",
    "collection",
    "filter",
    "in-memory",
    "php"
  ],
  "homepage": "https://github.com/SalvatoreCervone/memoryquerybuilder",
  "authors": [
    {
      "name": "Salvatore Cervone",
      "homepage": "https://github.com/SalvatoreCervone"
    }
  ],
  "support": {
    "issues": "https://github.com/SalvatoreCervone/memoryquerybuilder/issues",
    "source": "https://github.com/SalvatoreCervone/memoryquerybuilder"
  },
  "require": {
    "php": ">=8.1"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0"
  },
  "autoload": {
    "psr-4": {
      "MemoryQueryBuilder\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "MemoryQueryBuilder\\Tests\\": "tests/"
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
